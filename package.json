{
  "name": "paracosm",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "be": "bun run --cwd apps/http-backend dev",
    "db:generate": "bun run --filter @repo/db db:generate",
    "db:migrate": "bun run --filter @repo/db db:migrate",
    "db:push": "bun run --filter @repo/db db:push",
    "db:studio": "bun run --filter @repo/db db:studio",
    "ws": "bun --watch run apps/ws/src/index.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.4"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
